{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/distro", "hyprland/workspaces", "hyprland/window", "niri/workspaces", "niri/window" ],
    "modules-center": [],
    "modules-right": ["tray", "temperature", "memory", "cpu", "niri/language", "hyprland/language", "pulseaudio", "network", "battery", "clock"],
    "hyprland/language": {
        "format": "{short} 󰌌"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰽤",
            "active": "󰽢"
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5, 6, 7, 8]
        },
        "disable-scroll": true
    },
    "custom/distro": {
        "exec": "cat ~/.config/waybar/distro",
        "interval": "once",
        "tooltip": false
    },
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },
    "clock": {
        "format": "{:%A, %B %d at %I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffead3'><b>{}</b></span>",
                "days":       "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
                "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },
    "cpu": {
        "format": "{usage}% 󰻠",
        "tooltip-format": "CPU: {usage}%\nLoad: {load}",
        "on-click": "alacritty -t 'Floating Terminal' -e btop"
    },
    "temperature": {
        "format": "{temperatureC}°C 󰔏",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C 󰸁",
        "tooltip": false
    },
    "memory": {
        "format": "{used:0.1f}G 󰍛",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },
    "network": {
        "format": "󰈀 {ifname}",
        "format-wifi": "󰤨 {essid} ({signalStrength}%)",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤭 Disconnected",
        "tooltip-format": "{ifname}\n{ipaddr}/{cidr}"
    },
    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
    },
    "niri/workspaces": {
        "disable-scroll": true,
    },
    "niri/language": {
        "format": "{short} 󰌌"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphones": "",
            "default": ["", ""]
        },
        "on-click": "pavucontrol"
    }
}
