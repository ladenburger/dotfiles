QWidget {
	background-color: #282828;
	color: #ebdbb2;
	selection-background-color: #504945;
	selection-color: #fbf1c7;
}

QMainWindow, QDialog, QMenuBar, QStatusBar, QToolBar {
	background-color: #282828;
}

QToolTip {
	background-color: #3c3836;
	color: #ebdbb2;
	border: 1px solid #e8c597;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox {
	background-color: #1d2021;
	color: #ebdbb2;
	border: 1px solid #504945;
	border-radius: 0px;
	selection-background-color: #504945;
	selection-color: #fbf1c7;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QAbstractSpinBox:focus {
	border: 1px solid #e8c597;
}

QComboBox QAbstractItemView {
	background-color: #1d2021;
	color: #ebdbb2;
	border: 1px solid #504945;
	selection-background-color: #e8c597;
	selection-color: #1d2021;
}

QTextEdit#ChatLineEdit[helpTextVisible="true"] { color: #928374; }
QTextEdit#ChatLineEdit[helpTextVisible="false"] { color: #ebdbb2; }

QTextEdit#InfoFrame, QTextEdit#ChatTab, QTextBrowser {
	background-color: #232323;
	color: #ebdbb2;
}

QPushButton, QToolButton {
	background-color: #3c3836;
	color: #ebdbb2;
	border: 1px solid #504945;
	border-radius: 0px;
	padding: 3px 10px;
}
QPushButton:hover, QToolButton:hover { background-color: #504945; }
QPushButton:pressed, QToolButton:pressed { background-color: #665c54; }
QPushButton:default { border: 1px solid #e8c597; }
QPushButton:disabled, QToolButton:disabled { color: #665c54; background-color: #32302f; }
QToolButton::menu-indicator { image: none; }

QMenuBar::item { background: transparent; padding: 3px 8px; }
QMenuBar::item:selected { background-color: #3c3836; }

QMenu {
	background-color: #282828;
	color: #ebdbb2;
	border: 1px solid #e8c597;
}
QMenu::item { padding: 4px 22px; }
QMenu::item:selected { background-color: #e8c597; color: #1d2021; }
QMenu::item:disabled { color: #665c54; }
QMenu::separator { height: 1px; background: #504945; margin: 4px 8px; }

QTreeView, QTreeWidget, QListView, QListWidget, QTableView, QTableWidget, QColumnView {
	background-color: #232323;
	alternate-background-color: #282828;
	color: #ebdbb2;
	border: 1px solid #3c3836;
}
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
	background-color: #3c3836;
}
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
	background-color: #e8c597;
	color: #1d2021;
}
QTreeView#ServerTreeView { alternate-background-color: transparent; }

QHeaderView::section {
	background-color: #3c3836;
	color: #ebdbb2;
	border: 0px;
	border-right: 1px solid #282828;
	border-bottom: 1px solid #282828;
	padding: 3px 6px;
}

QTabWidget::pane { border: 1px solid #3c3836; }
QTabBar::tab {
	background: #32302f;
	color: #a89984;
	border: 1px solid #3c3836;
	padding: 4px 10px;
}
QTabBar::tab:selected { background: #282828; color: #ebdbb2; border-bottom-color: #e8c597; }
QTabBar::tab:hover { color: #ebdbb2; }
ImprovedTabBar::tab { color: #ebdbb2; }

QScrollBar:vertical { background: #282828; width: 12px; margin: 0; }
QScrollBar:horizontal { background: #282828; height: 12px; margin: 0; }
QScrollBar::handle { background: #504945; border-radius: 0px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #665c54; }
QScrollBar::add-line, QScrollBar::sub-line { background: none; border: none; height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QGroupBox { border: 1px solid #3c3836; margin-top: 8px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 3px; color: #a89984; }

QCheckBox, QRadioButton { background: transparent; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; }
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked { border: 1px solid #504945; background: #1d2021; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { border: 1px solid #e8c597; background: #e8c597; }

QProgressBar { border: 1px solid #504945; background: #1d2021; text-align: center; color: #ebdbb2; }
QProgressBar::chunk { background-color: #83a598; }

QSlider::groove:horizontal { height: 4px; background: #504945; }
QSlider::handle:horizontal { background: #e8c597; width: 12px; margin: -5px 0; }

QSplitter::handle { background-color: #3c3836; }

QLabel { background: transparent; }

QLabel#OptionsHeadlineTitleLabel, QLabel#OptionsHeadlineDescriptionLabel { color: #ebdbb2; }
QLabel#appNameLabel { color: #e8c597; }
QWidget#HeadlineLabel { background-color: #3c3836; }
