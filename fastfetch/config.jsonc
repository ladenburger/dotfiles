{
    "display": {
        "separator": " : "
    },
    "modules": [
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "red"
        },
        {
            "type": "command",
            "key": "   OS Age ",
            "keyColor": "31",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "   Uptime",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "   Packages",
            "keyColor": "red"
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "yellow"
        },
        {
            "type": "Theme",
            "key": "   Theme",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "Shell",
            "key": "   Shell",
            "keyColor": "magenta"
        },
        {
            "type": "editor",
            "key": "   Editor",
            "keyColor": "magenta"
        },
        {
            "type": "terminalfont",
            "key": "   Font",
            "keyColor": "magenta"
        },
        "break",
        {
            "type": "Disk",
            "key": "   Disk {mountpoint}",
            "keyColor": "blue"
        },
        {

            "type": "command",
            "key": "   Samba",
            "keyColor": "blue",
            "text": "df -P -t cifs 2>/dev/null | awk 'function fmt(k,  a,i){split(\"KiB MiB GiB TiB PiB\",a,\" \"); i=1; while(k>=1024&&i<5){k/=1024;i++} return sprintf(\"%.2f %s\",k,a[i])} NR>1 {split($1,h,\"/\"); if(!seen[h[3]\"|\"$2\"|\"$3]++) printf \"%s%s / %s (%s)\", (n++?\", \":\"\"), fmt($3), fmt($2), $5}'"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "cyan"
        },
        {
            "type":   "host",
            "key": "    Host",
            "keyColor": "yellow"

        },
        {
            "type": "gpu",
            "format": "{name}",
            "key": "   GPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": "   GPU Driver",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "   Display",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "   Memory",
            "keyColor": "magenta"
        },
        {
            "type": "swap",
            "key": "  󰾶 Swap",
            "keyColor": "magenta"
        },

        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
